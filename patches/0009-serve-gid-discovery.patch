+# The ring and NCCL use the device's RoCE v2 IPv4 GID. Its index depends on the address order after a netplan
+# apply or a reboot, so find it instead of hardcoding one (this pair has read 3 and 4 on different boots).
+gid_index() {
+  local d i t a
+  for d in ${RDMA_HCA//,/ }; do
+    for i in 0 1 2 3 4 5 6 7 8; do
+      t=$(cat "/sys/class/infiniband/$d/ports/1/gid_attrs/types/$i" 2>/dev/null)
+      a=$(cat "/sys/class/infiniband/$d/ports/1/gids/$i" 2>/dev/null)
+      [ "$t" = "RoCE v2" ] || continue
+      case "$a" in *:ffff:*) echo "$i"; return 0 ;; esac
+    done
+  done
+  return 1
+}
+GID_INDEX=$(gid_index) || { echo "no RoCE v2 IPv4 GID on $RDMA_HCA" >&2; exit 1; }
