@@ -43,6 +43,16 @@ pub const Settings = struct {
     probing: bool = false,
 };
 
+/// TF_RDMA_GID_INDEX: the GID index the ring's queue pairs use (the device's RoCE v2 IPv4 entry). The index
+/// depends on the address assignment order, so the launcher discovers it and sets it; unset keeps upstream's 5.
+pub fn servedGidIndex() u8 {
+    const raw = std.c.getenv("TF_RDMA_GID_INDEX") orelse return 5;
+    const text = std.mem.span(raw);
+    if (text.len == 0) return 5;
+    for (text) |c| if (c < '0' or c > '9') return 5;
+    return std.fmt.parseInt(u8, text, 10) catch 5;
+}
