# Serve shape: DeepSeek-V4.1-Flash-1017 EXL3 2.7 bpw + Keys L10-35, 2x GB10 (TP2).
# TensorFold Zig `c9c70953` (the v0.7.5 branch, with PR #51 merged) + the idle-nap patch
# (patches/0002) + this kit's 1M read-ahead clamp (patches/0005); recipe v0.7.5
# (`bertholomus/deepseek-v4.1-tensorfold-tp2-2xgb10`).
# Copy to config.env in the recipe checkout and fill in the paths and the fabric address.

NODES="spark-a spark-b"            # rank 0 first; passwordless ssh from the first node to the second
MASTER_IP="<FABRIC-IP>"            # rank 0's 200 GbE / RoCE address (ConnectX-7 side), not the LAN address
TP_PORT=29780
RDMA_HCA="rocep1s0f0,roceP2p1s0f0" # the two RoCE devices of a GB10 node; check `ibv_devices` on yours
NET_IF="enp1s0f0np0"               # the interface NCCL bootstraps on

MODEL_DIR="/mnt/models/dsv41-27-ablit"     # the grafted pack
ENGRAM_DIR="/mnt/models/dsv41-27-engram"   # DeepSeek's shards 47 and 48
ENGINE_DIR="/opt/dsv41-27-engine"          # tensorfold-native, tf-dsv41-lanes, tf-dsv41-rank-cache, node_inputs.sh
KIT_DIR="/opt/dsv41-27-recipe/kit"
CACHE_DIR="/mnt/models/dsv41-27-cache"     # rank cache (~93 GB) and dsv41_token_map.json
LOG_DIR="/var/log/dsv41"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

# Loopback by default. `HOST=0.0.0.0` serves the network: add `--api-key-file <path>` to SERVER_FLAGS before you do.
HOST=127.0.0.1
PORT=8888
SERVED_NAME=DeepSeek-V4.1-Flash-TF
SERVER_FLAGS="--thinking --max-tokens 32768 --temperature 1.0 --top-p 0.95 --top-k 20"

CONTEXT=1048576
WINDOW=5242880                     # the streams' shared positions: five 1M slots, or 32 streams at ~164K average;
                                   # 16 x 131K bursts and the 1M needle leave ~8 GiB on the head (see README notes)
STREAMS=32
ROUND_ROWS=64                      # v0.7.5 rounds; rows above 48 need the v0.7.5 kit's cubins
PARALLEL=32

# TF_DS_IDX_SPLIT=8192 and TF_DS_ROUND_MS (the 64-entry round cost table) are the v0.7.5 values.
# TF_DS_COPY_MIN=3 is the pack's measured setting (see the README notes). The three TF_FILL_* switches are
# PR #51's set, now part of the pinned engine commit: passes run two chunks at a time, a new request is
# admitted between pieces, and a burst's whole passes start back to back up to 8,192 rows.
ENGINE_ENV="TF_DS_GRAPHS=1 TF_DS_HC_SIDE=1 TF_DS_L2_PREFETCH=1 TF_DS_ENGRAM_AIO=1 TF_DS_REPLAY_FLOOR=1 TF_DS_IDX_SPLIT=8192 TENSORFOLD_PLAIN_SPECIALS=1 TENSORFOLD_GRAMMAR_LIB=/kit/grammar/libtfgrammar.so TENSORFOLD_SSE_KEEPALIVE=15 TENSORFOLD_STATS_EVERY=60 TF_DS_PROMPT_ALIAS=1 TF_DS_COPY_MIN=3 TENSORFOLD_REPLY_IDS=1 TF_DS_NEIGHBOR_GID_INDEX=3 TF_FILL_CHUNKS=2 TF_FILL_MANY=1 TF_FILL_DRAIN=8192 TF_DS_ROUND_MS=30.0,35.2,39.9,44.9,48.6,52.1,55.6,59.1,62.7,66.3,69.6,72.9,75.5,78.2,81.3,84.4,87.5,90.6,93.7,96.8,99.9,103.0,106.1,109.2,112.2,115.3,122.0,123.9,125.5,127.2,130.5,134.6,138.8,142.9,145.9,148.2,150.6,152.9,155.3,157.6,160.0,162.3,164.7,167.0,169.4,171.7,174.1,176.4,179.0,181.6,184.2,186.9,189.5,192.1,194.7,197.3,199.9,202.5,205.1,207.8,210.4,213.0,215.6,218.2"

RANK0_FLAGS="--prompt-cache-gib 2 --thinking-budget 32768"
