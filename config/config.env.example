# Serve shape: DeepSeek-V4.1-Flash-1017 EXL3 2.7 bpw + Keys L10-35, 2x GB10 (TP2).
# TensorFold Zig `a57deb9` + the idle-nap patch; recipe v0.7.3 (`bertholomus/deepseek-v4.1-tensorfold-tp2-2xgb10`).
# Copy to config.env in the recipe checkout and fill in the paths and the fabric address.

NODES="spark-a spark-b"            # rank 0 first; passwordless ssh from the first node to the second
MASTER_IP="<FABRIC-IP>"            # rank 0's 200 GbE / RoCE address (ConnectX-7 side), not the LAN address
TP_PORT=29780
RDMA_HCA="rocep1s0f0,roceP2p1s0f0" # the two RoCE devices of a GB10 node; check `ibv_devices` on yours
NET_IF="enp1s0f0np0"               # the interface NCCL bootstraps on

MODEL_DIR="/mnt/models/dsv41-27-ablit"     # the grafted pack
ENGRAM_DIR="/mnt/models/dsv41-27-engram"   # DeepSeek's shards 47 and 48
ENGINE_DIR="/opt/dsv41-27-engine"          # tensorfold-native, tf-dsv41-lanes, tf-dsv41-rank-cache, node_inputs.sh
KIT_DIR="/opt/dsv41-27-recipe/kit"
CACHE_DIR="/mnt/models/dsv41-27-cache"     # rank cache (~93 GB) and dsv41_token_map.json
LOG_DIR="/var/log/dsv41"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

# Loopback by default. `HOST=0.0.0.0` serves the network: add `--api-key-file <path>` to SERVER_FLAGS before you do.
HOST=127.0.0.1
PORT=8888
SERVED_NAME=DeepSeek-V4.1-Flash-TF
SERVER_FLAGS="--thinking --max-tokens 32768 --temperature 1.0 --top-p 0.95 --top-k 20"

CONTEXT=1048576
WINDOW=3932160                     # the streams' shared positions; 16 x 131K bursts fit with ~9 GiB left on the head
STREAMS=16
ROUND_ROWS=32
PARALLEL=16

# TF_DS_IDX_SPLIT=8192 is the v0.7.4 value, TF_DS_COPY_MIN=3 is the pack's measured setting (see the README notes),
# and the three TF_FILL_* switches are the burst/cut-in set (patches/0003): passes run two chunks at a time, a new
# request is admitted between pieces, and a burst's whole passes start back to back up to 8,192 rows.
ENGINE_ENV="TF_DS_GRAPHS=1 TF_DS_HC_SIDE=1 TF_DS_L2_PREFETCH=1 TF_DS_ENGRAM_AIO=1 TF_DS_REPLAY_FLOOR=1 TF_DS_IDX_SPLIT=8192 TENSORFOLD_PLAIN_SPECIALS=1 TENSORFOLD_GRAMMAR_LIB=/kit/grammar/libtfgrammar.so TENSORFOLD_SSE_KEEPALIVE=15 TENSORFOLD_STATS_EVERY=60 TF_DS_PROMPT_ALIAS=1 TF_DS_COPY_MIN=3 TENSORFOLD_REPLY_IDS=1 TF_DS_NEIGHBOR_GID_INDEX=3 TF_FILL_CHUNKS=2 TF_FILL_MANY=1 TF_FILL_DRAIN=8192"

RANK0_FLAGS="--prompt-cache-gib 2 --thinking-budget 32768"
